# Tiene que ser literalmente "accept" (o "view" para solo mostrar la licencia sin arrancar el server).
TS3SERVER_LICENSE=accept

# Configuración aplicada una sola vez, en el primer boot, por scripts/configure_server.sh
# (via ServerQuery). Si el server ya arrancó antes, cambiar esto acá no hace nada — hay que
# editarlo a mano desde el cliente o ServerQuery.
TS3_SERVER_NAME=el SERVER del guidoti
TS3_SERVER_PASSWORD=asdf
TS3_CHANNEL_1=LOBBYS
TS3_CHANNEL_2=MIX10-Team1
TS3_CHANNEL_3=MIX10-Team2
